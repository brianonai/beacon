# --- Google OAuth (required) -----------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Type: "OAuth client ID" -> "Web application"
# Authorized redirect URI must match OAUTH_REDIRECT_URI below.
# Docker Compose (see docker-compose.yml): http://localhost:18080/auth/google/callback
# Local uvicorn + next dev: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# OAuth redirect URI (must match Google Cloud Console)
OAUTH_REDIRECT_URI=http://localhost:18080/auth/google/callback

# Where to send the user after a successful login (match the web URL you use)
POST_LOGIN_REDIRECT=http://localhost:13000/

# --- Session signing -------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=replace-me-with-a-long-random-string

# --- Frontend origin (CORS) ------------------------------------------------
ALLOWED_ORIGIN=http://localhost:13000

# Required for local OAuth on http://localhost.
# Disables oauthlib's client-side HTTPS check. The Google server still
# allows localhost on http; this is just the Python library being strict.
# REMOVE THIS in any HTTPS or production deployment.
OAUTHLIB_INSECURE_TRANSPORT=1

# --- Scan tuning (optional) ------------------------------------------------
# INSPECT_CONCURRENCY=10
# INSPECT_JITTER_MS=100
# STALE_DAYS=180

# --- Site preview (Microlink, optional) ------------------------------------
# Optional x-api-key: https://microlink.io/docs/api/basics/authentication
# MICROLINK_API_KEY=
